# Dev: keep /api/v1 (Vite proxies /api -> VITE_PROXY_TARGET so the refresh cookie stays same-site).
# Prod: full URL, e.g. https://prop-flow-black.vercel.app/api/v1
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:3000
VITE_GOOGLE_OAUTH_ENABLED=false
VITE_CURRENCY_CODE=EGP
VITE_SUPPORT_EMAIL=
VITE_DEFAULT_LANG=ar
# Dev only: fake backend with demo accounts (password demo12345). Never ships in production builds.
VITE_MOCK=false
